<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Must match the provisioning profile: the sandbox APNs for Debug/Profile
	     builds, Apple's production APNs for anything archived for TestFlight or
	     the App Store. Without this entitlement registration fails at runtime
	     ("no valid aps-environment entitlement") no matter what the App ID says. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Sign in with Apple (App Review 4.8: required alongside Google
	     sign-in). The App ID must have the capability enabled too, or the
	     profile won't carry it and signing fails. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
